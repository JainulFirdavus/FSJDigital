# Copy to .env for local development (npm run dev loads it automatically).

# Admin password for /admin (defaults to "admin" locally; REQUIRED in production)
ADMIN_PASSWORD=change-me

# Leave empty locally to use the built-in SQLite file (data/site.db).
# On Render, use a Postgres URL (Neon free tier): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Email via Resend (https://resend.com). Without these, emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM="FSJ Digital <onboarding@resend.dev>"
ADMIN_EMAIL=

# Public address of the site (used in email links and SEO tags)
PUBLIC_URL=http://localhost:3000
